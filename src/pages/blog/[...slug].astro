---
export const prerender = false;

import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostBySlug } from '../../server/db';

const slug = decodeURIComponent(Astro.params.slug ?? '');
const post = getPostBySlug(slug);
if (!post) {
  return new Response('文章不存在', { status: 404 });
}

const html = marked.parse(post.body) as string;
const tags: string[] = (() => {
  try {
    return JSON.parse(post.tags);
  } catch {
    return [];
  }
})();
---

<BaseLayout title={post.title} description={post.summary || post.title}>
  <article class="post">
    <header>
      <h1>{post.title}</h1>
      <div class="post-meta">
        <time datetime={post.pub_date}>{post.pub_date}</time>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a class="chip" href={`/tags/${tag}/`}>#{tag}</a>
            ))}
          </div>
        )}
      </div>
    </header>
    <div class="prose" set:html={html} />
  </article>
</BaseLayout>
