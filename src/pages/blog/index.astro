---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../server/db';

const posts = publishedPosts();

// 置顶文章排最前，其余按日期倒序
const sorted = [
  ...posts.filter((p) => p.featured === 1),
  ...posts.filter((p) => p.featured !== 1),
];

const byYear = new Map<number, typeof posts>();
for (const p of sorted) {
  const y = Number(p.pub_date.slice(0, 4)) || 0;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const tagsOf = (post: (typeof posts)[number]): string[] => {
  try {
    return JSON.parse(post.tags);
  } catch {
    return [];
  }
};

const fmt = (d: string) => d.slice(5);
---

<BaseLayout title="平凡日记" description="子諭的学习笔记、随笔与生活记录">
  <h1>平凡日记</h1>
  <p class="page-desc">
    读书 · 学习 · 去更远的地方 · <a href="/tags/">按标签浏览</a>
  </p>
  {years.map((year) => (
    <section class="year-group">
      <h2>{year}</h2>
      <ul class="post-list">
        {byYear.get(year)!.map((post) => (
          <li>
            <div class="post-main">
              <a href={`/blog/${post.slug}/`}>
                {post.title}
                {post.featured === 1 && <span class="badge">置顶</span>}
              </a>
              {tagsOf(post).length > 0 && (
                <div class="post-tags">
                  {tagsOf(post).map((tag) => (
                    <a class="chip" href={`/tags/${tag}/`}>#{tag}</a>
                  ))}
                </div>
              )}
            </div>
            <time datetime={post.pub_date}>{fmt(post.pub_date)}</time>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
