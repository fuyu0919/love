---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 置顶文章排最前，其余按日期倒序
const sorted = [
  ...posts.filter((p) => p.data.featured),
  ...posts.filter((p) => !p.data.featured),
];

const byYear = new Map<number, typeof posts>();
for (const p of sorted) {
  const y = p.data.pubDate.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const fmt = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="平凡日记" description="子諭的学习笔记、随笔与生活记录">
  <h1>平凡日记</h1>
  <p class="page-desc">
    读书 · 学习 · 去更远的地方 · <a href="/tags/">按标签浏览</a>
  </p>
  {years.map((year) => (
    <section class="year-group">
      <h2>{year}</h2>
      <ul class="post-list">
        {byYear.get(year)!.map((post) => (
          <li>
            <div class="post-main">
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
                {post.data.featured && <span class="badge">置顶</span>}
              </a>
              {post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <a class="chip" href={`/tags/${tag}/`}>#{tag}</a>
                  ))}
                </div>
              )}
            </div>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
