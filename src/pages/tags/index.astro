---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { allTags } from '../../server/db';

const tags = allTags();
---

<BaseLayout title="标签">
  <h1>标签</h1>
  <div class="tag-cloud">
    {tags.map(({ tag, count }) => (
      <a href={`/tags/${tag}/`}>
        #{tag}
        <span class="count">{count}</span>
      </a>
    ))}
  </div>
</BaseLayout>
