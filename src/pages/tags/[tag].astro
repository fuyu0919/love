---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../server/db';

const tag = decodeURIComponent(Astro.params.tag ?? '');
const posts = publishedPosts().filter((post) => {
  try {
    return (JSON.parse(post.tags) as string[]).includes(tag);
  } catch {
    return false;
  }
});

const fmt = (d: string) => d.slice(5);
---

<BaseLayout title={`标签：${tag}`}>
  <h1>#{tag}</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.slug}/`}>{post.title}</a>
        <time datetime={post.pub_date}>{fmt(post.pub_date)}</time>
      </li>
    ))}
  </ul>
</BaseLayout>
