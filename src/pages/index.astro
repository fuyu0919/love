---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, INTRO, DIARY, STORY, STORY_HERO_PHOTOS, GATE } from '../consts';
import { publishedPosts } from '../server/db';

const posts = publishedPosts();
const latest = posts.slice(0, 3);
const fmt = (d: string) => d;
---

<BaseLayout>
  <div id="gate" class="gate">
    <form class="gate-card" id="gate-form" autocomplete="off">
      <p class="gate-eyebrow">{SITE.title}</p>
      <h1>先对个暗号</h1>
      <p class="gate-q">问题：{GATE.question}</p>
      <input
        id="gate-input"
        type="password"
        inputmode="numeric"
        placeholder="请输入答案"
        aria-label="答案"
        autofocus
      />
      <p class="gate-error" id="gate-error" role="alert"></p>
      <button type="submit">进入</button>
      <p class="gate-hint">{GATE.hint}</p>
    </form>
  </div>
  <script is:inline define:vars={{ answer: GATE.answer }}>
    (function () {
      const gate = document.getElementById('gate');
      if (!gate) return;
      document.documentElement.classList.add('gate-open');
      const form = document.getElementById('gate-form');
      const input = document.getElementById('gate-input');
      const error = document.getElementById('gate-error');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (input.value.trim() === String(answer)) {
          document.documentElement.classList.remove('gate-open');
          gate.remove();
        } else {
          error.textContent = '答案不对，再试试～';
          form.classList.remove('shake');
          void form.offsetWidth;
          form.classList.add('shake');
          input.select();
        }
      });
    })();
  </script>

  <section class="hero hero--compact">
    <img src={SITE.avatar} alt="头像" width="88" height="88" />
    <div>
      <h1>{SITE.name}</h1>
      <p class="tagline">{SITE.tagline}</p>
    </div>
  </section>

  <section class="intro">
    {INTRO.map((p) => <p>{p}</p>)}
  </section>

  <section class="portals">
    <a class="portal portal--diary" href={DIARY.href}>
      <span class="portal-eyebrow">{DIARY.eyebrow}</span>
      <h2>{DIARY.title}</h2>
      <p class="portal-sub">{DIARY.subtitle}</p>
      <p class="portal-desc">{DIARY.description}</p>
      <ul class="portal-posts">
        {latest.map((post) => (
          <li>
            <span>{post.title}</span>
            <time datetime={post.pub_date}>{fmt(post.pub_date)}</time>
          </li>
        ))}
      </ul>
      <span class="portal-enter">进入日记 →</span>
    </a>

    <a class="portal portal--story" href={STORY.href}>
      <span class="portal-eyebrow">{STORY.eyebrow}</span>
      <h2>{STORY.title}</h2>
      <p class="portal-sub">{STORY.subtitle}</p>
      <p class="portal-desc">{STORY.description}</p>
      <div class="portal-photos">
        {STORY_HERO_PHOTOS.slice(0, 3).map((src) => (
          <img src={src} alt="" loading="lazy" />
        ))}
      </div>
      <span class="portal-enter">进入故事 →</span>
    </a>
  </section>
</BaseLayout>
