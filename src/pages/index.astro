---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, INTRO, DIARY, STORY, STORY_HERO_PHOTOS } from '../consts';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 3);
const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout>
  <section class="hero hero--compact">
    <img src={SITE.avatar} alt="头像" width="88" height="88" />
    <div>
      <h1>{SITE.name}</h1>
      <p class="tagline">{SITE.tagline}</p>
    </div>
  </section>

  <section class="intro">
    {INTRO.map((p) => <p>{p}</p>)}
  </section>

  <section class="portals">
    <a class="portal portal--diary" href={DIARY.href}>
      <span class="portal-eyebrow">{DIARY.eyebrow}</span>
      <h2>{DIARY.title}</h2>
      <p class="portal-sub">{DIARY.subtitle}</p>
      <p class="portal-desc">{DIARY.description}</p>
      <ul class="portal-posts">
        {latest.map((post) => (
          <li>
            <span>{post.data.title}</span>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </li>
        ))}
      </ul>
      <span class="portal-enter">进入日记 →</span>
    </a>

    <a class="portal portal--story" href={STORY.href}>
      <span class="portal-eyebrow">{STORY.eyebrow}</span>
      <h2>{STORY.title}</h2>
      <p class="portal-sub">{STORY.subtitle}</p>
      <p class="portal-desc">{STORY.description}</p>
      <div class="portal-photos">
        {STORY_HERO_PHOTOS.slice(0, 3).map((src) => (
          <img src={src} alt="" loading="lazy" />
        ))}
      </div>
      <span class="portal-enter">进入故事 →</span>
    </a>
  </section>
</BaseLayout>
