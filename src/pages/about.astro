---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title="关于">
  <h1>关于</h1>
  <div class="about-card prose">
    <p>我是 {SITE.name}，「{SITE.tagline}」。</p>
    <p>
      这里有两个部分：<a href="/blog/">平凡日记</a>记录学习、技术积累和一些随想；<a href="/story/">我们的故事</a>收藏两个人的照片、视频与时光。
    </p>
    <p>本站使用 <a href="https://astro.build">Astro</a> 构建，托管在静态服务器上，没有追踪脚本。</p>
  </div>

  <h2 class="section-title"><span>联系我</span></h2>
  <ul class="contact-list">
    <li>
      <span class="label">邮箱</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </li>
    <li>
      <span class="label">GitHub</span>
      <a href={SITE.github} target="_blank" rel="noopener">
        {SITE.github.replace('https://', '')}
      </a>
    </li>
  </ul>
</BaseLayout>
