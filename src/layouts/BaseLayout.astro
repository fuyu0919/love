---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;

const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
const isActive = (href: string) =>
  href === '/' ? path === '' : path.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={SITE.avatar} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">{SITE.title}</a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'true' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      © {new Date().getFullYear()} {SITE.name} · 用 Astro 搭建
    </footer>
  </body>
</html>
