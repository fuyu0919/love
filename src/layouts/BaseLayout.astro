---
import '../styles/global.css';
import { SITE, GATE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;

const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '平凡日记' },
  { href: '/story/', label: '我们的故事' },
  { href: '/about/', label: '关于' },
];
const isActive = (href: string) =>
  href === '/' ? path === '' : path.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={SITE.avatar} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div id="gate" class="gate">
      <form class="gate-card" id="gate-form" autocomplete="off">
        <p class="gate-eyebrow">{SITE.title}</p>
        <h1>先对个暗号</h1>
        <p class="gate-q">问题：{GATE.question}</p>
        <input
          id="gate-input"
          type="password"
          inputmode="numeric"
          placeholder="请输入答案"
          aria-label="答案"
          autofocus
        />
        <p class="gate-error" id="gate-error" role="alert"></p>
        <button type="submit">进入</button>
        <p class="gate-hint">{GATE.hint}</p>
      </form>
    </div>
    <script is:inline define:vars={{ answer: GATE.answer }}>
      (function () {
        const gate = document.getElementById('gate');
        if (!gate) return;
        document.documentElement.classList.add('gate-open');
        const form = document.getElementById('gate-form');
        const input = document.getElementById('gate-input');
        const error = document.getElementById('gate-error');
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          if (input.value.trim() === String(answer)) {
            document.documentElement.classList.remove('gate-open');
            gate.remove();
          } else {
            error.textContent = '答案不对，再试试～';
            form.classList.remove('shake');
            void form.offsetWidth;
            form.classList.add('shake');
            input.select();
          }
        });
      })();
    </script>

    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">{SITE.title}</a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'true' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-links">
          <a href="/blog/">平凡日记</a>
          <a href="/story/">我们的故事</a>
          <a href="/tags/">标签</a>
          <a href="/about/">关于</a>
          <a href={`mailto:${SITE.email}`}>邮箱</a>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
        </div>
        <div>© {new Date().getFullYear()} {SITE.name} · 用 Astro 搭建</div>
        {SITE.icp && (
          <div class="icp">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
              {SITE.icp}
            </a>
          </div>
        )}
      </div>
    </footer>
  </body>
</html>
