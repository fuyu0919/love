---
import type { PostInput } from '../../server/db';

interface Props {
  input: PostInput;
  error?: string;
  submitLabel?: string;
}

const { input, error = '', submitLabel = '保存' } = Astro.props;
---

{error && <div class="alert alert--error">{error}</div>}

<div class="form-grid">
  <div class="form-row">
    <div class="field">
      <label for="title">标题</label>
      <input id="title" name="title" type="text" value={input.title} required />
    </div>
    <div class="field">
      <label for="slug">链接别名</label>
      <input id="slug" name="slug" type="text" value={input.slug} />
      <p class="hint">留空则根据标题自动生成，只能用英文、数字和短横线。</p>
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <label for="pub_date">发布日期</label>
      <input id="pub_date" name="pub_date" type="date" value={input.pub_date} />
    </div>
    <div class="field">
      <label for="status">状态</label>
      <select id="status" name="status">
        <option value="published" selected={input.status === 'published'}>已发布</option>
        <option value="draft" selected={input.status === 'draft'}>草稿</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="tags">标签</label>
    <input id="tags" name="tags" type="text" value={input.tags.join(', ')} />
    <p class="hint">多个标签用逗号分隔。</p>
  </div>

  <div class="field">
    <label for="summary">摘要</label>
    <input id="summary" name="summary" type="text" value={input.summary} />
    <p class="hint">留空时列表页会显示正文开头。</p>
  </div>

  <div class="field">
    <label class="checkbox">
      <input type="checkbox" name="featured" checked={input.featured} />
      在日记列表置顶
    </label>
  </div>

  <div class="field">
    <label for="body">正文（Markdown）</label>
    <textarea id="body" name="body">{input.body}</textarea>
  </div>
</div>

<div class="form-actions">
  <button class="btn btn--primary" type="submit">{submitLabel}</button>
  <a class="btn" href="/admin/posts">返回列表</a>
</div>
