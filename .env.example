# 复制成 .env 后填写；生产环境用 systemd 的 EnvironmentFile 加载
# 初始管理员账号（仅首次执行 npm run seed 时使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SQLite 数据库位置，默认 data/site.db
DATABASE_PATH=./data/site.db

# 阿里云 OSS 直传（不填则后台只能手动填写图片/视频地址）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# CDN 加速域名，例如 https://cdn.yujianxiaoquan.online；不填则直接用 OSS 域名
OSS_CDN_HOST=
# 上传目录前缀
OSS_DIR=uploads
